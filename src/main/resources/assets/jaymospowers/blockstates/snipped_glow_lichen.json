{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "jaymospowers:block/tundra/snipped_glow_lichen"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "jaymospowers:block/tundra/snipped_glow_lichen",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "jaymospowers:block/tundra/snipped_glow_lichen",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "jaymospowers:block/tundra/snipped_glow_lichen",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false",
        "up": "false",
        "down": "false"
      },
      "apply": {
        "model": "jaymospowers:block/tundra/snipped_glow_lichen"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": [
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ground"
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ground",
          "y": 90
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ground",
          "y": 180
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ground",
          "y": 270
        }
      ]
    },
    {
      "when": {
        "up": "true"
      },
      "apply": [
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ceiling"
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ceiling",
          "y": 90
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ceiling",
          "y": 180
        },
        {
          "model": "jaymospowers:block/tundra/snipped_glow_lichen_ceiling",
          "y": 270
        }
      ]
    }
  ]
}
