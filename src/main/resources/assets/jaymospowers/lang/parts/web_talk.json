{
	"message.jaymospowers.web_symbiote.talk.hunger.starving.1": "We are starving. Do not make me say it twice.",
	"message.jaymospowers.web_symbiote.talk.hunger.starving.2": "Empty. Hollow. You are warm and walking and I am empty.",
	"message.jaymospowers.web_symbiote.talk.hunger.starving.3": "So hungry the dark starts to taste of something.",
	"message.jaymospowers.web_symbiote.talk.hunger.hungry.1": "Not full. Not close.",
	"message.jaymospowers.web_symbiote.talk.hunger.hungry.2": "Meat. Dead meat. Find it before I get impatient.",
	"message.jaymospowers.web_symbiote.talk.hunger.hungry.3": "A little longer and I stop asking nicely.",
	"message.jaymospowers.web_symbiote.talk.hunger.fed.1": "Full. For now. Do not get used to it.",
	"message.jaymospowers.web_symbiote.talk.hunger.fed.2": "Warm and heavy. I could stay like this.",
	"message.jaymospowers.web_symbiote.talk.hunger.fed.3": "We ate. We are quiet. Enjoy it.",
	"message.jaymospowers.web_symbiote.talk.mood.content.1": "Quiet. Good. Keep it so.",
	"message.jaymospowers.web_symbiote.talk.mood.content.2": "I am easy. Do not test it.",
	"message.jaymospowers.web_symbiote.talk.mood.content.3": "Warm. Fed enough. Yours.",
	"message.jaymospowers.web_symbiote.talk.mood.anxious.1": "Something is wrong. I feel it in the edges.",
	"message.jaymospowers.web_symbiote.talk.mood.anxious.2": "Too loud. Too bright. Move.",
	"message.jaymospowers.web_symbiote.talk.mood.anxious.3": "I am listening for something. Be still.",
	"message.jaymospowers.web_symbiote.talk.mood.coiled.1": "Wound tight. Pull the thread and see.",
	"message.jaymospowers.web_symbiote.talk.mood.coiled.2": "Do not ask. Hit something.",
	"message.jaymospowers.web_symbiote.talk.mood.coiled.3": "I am a held breath.",
	"message.jaymospowers.web_symbiote.talk.mood.grieving.1": "...Gone.",
	"message.jaymospowers.web_symbiote.talk.mood.grieving.2": "Do not talk. Not now.",
	"message.jaymospowers.web_symbiote.talk.mood.grieving.3": "We carry it. Leave it.",
	"message.jaymospowers.web_symbiote.talk.trust.low.1": "You? We are still deciding.",
	"message.jaymospowers.web_symbiote.talk.trust.low.2": "Not yet. Earn it.",
	"message.jaymospowers.web_symbiote.talk.trust.low.3": "Ask me later. Or never.",
	"message.jaymospowers.web_symbiote.talk.trust.mid.1": "Some. Enough to answer you.",
	"message.jaymospowers.web_symbiote.talk.trust.mid.2": "You are not nothing.",
	"message.jaymospowers.web_symbiote.talk.trust.mid.3": "Better than before. Do not stop.",
	"message.jaymospowers.web_symbiote.talk.trust.high.1": "Yours. Skin and all.",
	"message.jaymospowers.web_symbiote.talk.trust.high.2": "Closer than anything. Do not let go.",
	"message.jaymospowers.web_symbiote.talk.trust.high.3": "I would not leave. Remember who stays.",
	"message.jaymospowers.web_symbiote.talk.foe.fight.1": "%s. Keep hitting.",
	"message.jaymospowers.web_symbiote.talk.foe.fight.2": "I can taste %s on the air. Finish it.",
	"message.jaymospowers.web_symbiote.talk.foe.fight.3": "%s is ours when it falls.",
	"message.jaymospowers.web_symbiote.talk.foe.look.1": "%s. I see it too. What do we do?",
	"message.jaymospowers.web_symbiote.talk.foe.look.2": "You are looking at %s. So am I.",
	"message.jaymospowers.web_symbiote.talk.foe.look.3": "%s. Hm. Is it worth it?",
	"message.jaymospowers.web_symbiote.talk.foe.none.1": "Nothing in front of us. Nothing yet.",
	"message.jaymospowers.web_symbiote.talk.foe.none.2": "No one to hit. Pity.",
	"message.jaymospowers.web_symbiote.talk.foe.none.3": "Dark and wall. That is all I see.",
	"message.jaymospowers.web_symbiote.talk.grudge.none.1": "No one owes us. Not today.",
	"message.jaymospowers.web_symbiote.talk.grudge.none.2": "Nobody pending. I get bored.",
	"message.jaymospowers.web_symbiote.talk.grudge.none.3": "A clean slate. It never stays clean.",
	"message.jaymospowers.web_symbiote.talk.grudge.player.1": "%s. I remember the hands.",
	"message.jaymospowers.web_symbiote.talk.grudge.player.2": "%s owes us. I keep count.",
	"message.jaymospowers.web_symbiote.talk.grudge.player.3": "%s. Say the word.",
	"message.jaymospowers.web_symbiote.talk.grudge.mob.1": "%s hurt us. They all look alike. I do not forgive them.",
	"message.jaymospowers.web_symbiote.talk.grudge.mob.2": "%s. We are owed.",
	"message.jaymospowers.web_symbiote.talk.grudge.mob.3": "Find a %s. I will do the rest.",
	"message.jaymospowers.web_symbiote.talk.fury.calm.1": "Cold. For now.",
	"message.jaymospowers.web_symbiote.talk.fury.calm.2": "Nothing to burn.",
	"message.jaymospowers.web_symbiote.talk.fury.calm.3": "Sleeping heat. Give it a reason.",
	"message.jaymospowers.web_symbiote.talk.fury.warm.1": "It is building. Feel it in the shoulders.",
	"message.jaymospowers.web_symbiote.talk.fury.warm.2": "Warm. Getting warmer.",
	"message.jaymospowers.web_symbiote.talk.fury.warm.3": "Keep hitting.",
	"message.jaymospowers.web_symbiote.talk.fury.hot.1": "Hot. Hot. Let me--",
	"message.jaymospowers.web_symbiote.talk.fury.hot.2": "It is all heat. Roar, or burst.",
	"message.jaymospowers.web_symbiote.talk.fury.hot.3": "Full. Do something with it.",
	"message.jaymospowers.web_symbiote.talk.suit.out.1": "We are out. Look how small everything is.",
	"message.jaymospowers.web_symbiote.talk.suit.out.2": "Big. Good. Keep moving.",
	"message.jaymospowers.web_symbiote.talk.suit.out.3": "No cage. Do not put me back.",
	"message.jaymospowers.web_symbiote.talk.suit.caged.1": "You keep me folded. I count the minutes.",
	"message.jaymospowers.web_symbiote.talk.suit.caged.2": "Let me out and I am not gentle.",
	"message.jaymospowers.web_symbiote.talk.suit.caged.3": "Shut away. Remember that.",
	"message.jaymospowers.web_symbiote.talk.suit.not_yet.1": "Not yet. Not enough of us for that.",
	"message.jaymospowers.web_symbiote.talk.suit.not_yet.2": "The big one is not ready. Closer.",
	"message.jaymospowers.web_symbiote.talk.suit.not_yet.3": "Be patient. We are nearly one.",
	"message.jaymospowers.web_symbiote.talk.sleep.night.1": "Night. Good. The dark is ours.",
	"message.jaymospowers.web_symbiote.talk.sleep.night.2": "Sleep if you must. I do not.",
	"message.jaymospowers.web_symbiote.talk.sleep.night.3": "Night is when I am loudest. Lie still.",
	"message.jaymospowers.web_symbiote.talk.sleep.day.1": "Day. Too bright, but fine.",
	"message.jaymospowers.web_symbiote.talk.sleep.day.2": "Sleep later. Walk now.",
	"message.jaymospowers.web_symbiote.talk.sleep.day.3": "Sun on skin. Warm. I tolerate it.",
	"message.jaymospowers.web_symbiote.talk.name.1": "%s. Yes. I know. I have said it inside your head a thousand times.",
	"message.jaymospowers.web_symbiote.talk.name.2": "%s. Your name tastes of salt.",
	"message.jaymospowers.web_symbiote.talk.name.3": "%s. Mine is not for you. Not yet.",
	"message.jaymospowers.web_symbiote.talk.insult.1": "Careful.",
	"message.jaymospowers.web_symbiote.talk.insult.2": "Say that again and we go quiet.",
	"message.jaymospowers.web_symbiote.talk.insult.3": "Small words. I remember them.",
	"message.jaymospowers.web_symbiote.talk.thanks.1": "...Hm. Keep that.",
	"message.jaymospowers.web_symbiote.talk.thanks.2": "Good. Say it again later.",
	"message.jaymospowers.web_symbiote.talk.thanks.3": "Warm. That was warm.",
	"message.jaymospowers.web_symbiote.talk.other.1": "Hm.",
	"message.jaymospowers.web_symbiote.talk.other.2": "I hear you. I do not always answer.",
	"message.jaymospowers.web_symbiote.talk.other.3": "Say it plainer.",
	"message.jaymospowers.web_symbiote.talk.other.4": "Words. Mostly words.",
	"message.jaymospowers.web_symbiote.talk.deaf.1": "Too far. Not yet.",
	"message.jaymospowers.web_symbiote.talk.deaf.2": "Noise. Just noise.",
	"message.jaymospowers.web_symbiote.talk.deaf.3": "Later.",
	"message.jaymospowers.web_symbiote.grudge.near.player.1": "%s is close. I can smell them.",
	"message.jaymospowers.web_symbiote.grudge.near.player.2": "%s. Right there. Say the word.",
	"message.jaymospowers.web_symbiote.grudge.near.player.3": "They are near. %s. Do you remember?",
	"message.jaymospowers.web_symbiote.grudge.near.mob.1": "A %s. One of those hurt us.",
	"message.jaymospowers.web_symbiote.grudge.near.mob.2": "%s, close. I remember what they did.",
	"message.jaymospowers.web_symbiote.grudge.near.mob.3": "There. %s. We owe them.",
	"message.jaymospowers.web_symbiote.grudge.paid.player.1": "%s is done. Good. That sits better.",
	"message.jaymospowers.web_symbiote.grudge.paid.player.2": "Paid. %s. Keep going.",
	"message.jaymospowers.web_symbiote.grudge.paid.player.3": "That was owed. Thank you.",
	"message.jaymospowers.web_symbiote.grudge.paid.mob.1": "One less %s. Not enough, but it helps.",
	"message.jaymospowers.web_symbiote.grudge.paid.mob.2": "Paid, a little. %s.",
	"message.jaymospowers.web_symbiote.grudge.paid.mob.3": "Good. That one remembered us.",
	"message.jaymospowers.web_symbiote.meeting.1.1": "I have watched through your eyes a long time.",
	"message.jaymospowers.web_symbiote.meeting.2.1": "You never looked at me. Look.",
	"message.jaymospowers.web_symbiote.meeting.3.1": "This is the shape of the weight you carry.",
	"message.jaymospowers.web_symbiote.meeting.end.1": "There. Back inside. Do not forget the face.",
	"gui.jaymospowers.web_symbiote.status.grudges": "It remembers",
	"gui.jaymospowers.web_symbiote.status.grudge_damage": "%s hearts"
}