	"message.jaymospowers.web_symbiote.execution.rupture_stab": "Rupture: %s",
	"message.jaymospowers.web_symbiote.say.carapace.1": "Harder. Harder than they can break.",
	"message.jaymospowers.web_symbiote.say.carapace.2": "Plates. Hold.",
