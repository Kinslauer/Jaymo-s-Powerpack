	"message.jaymospowers.web_symbiote.say.white.aegis.1": "A shell. Gentle. Then not.",
	"message.jaymospowers.web_symbiote.say.white.aegis.2": "Whatever they give, we give back.",
	"message.jaymospowers.web_symbiote.say.white.aegis.3": "Stay behind us.",
	"message.jaymospowers.web_symbiote.say.white.aegis_return.1": "Returned.",
	"message.jaymospowers.web_symbiote.say.white.aegis_return.2": "That was yours.",
	"message.jaymospowers.web_symbiote.say.white.aegis_return.3": "We warned you.",
	"message.jaymospowers.web_symbiote.say.lash.1": "Round and round!",
	"message.jaymospowers.web_symbiote.say.lash.2": "A whip of us. Taste it.",
	"message.jaymospowers.web_symbiote.say.lash.3": "All of you. At once.",
	"message.jaymospowers.web_symbiote.say.white.lash.1": "Back. Back away. Please.",
	"message.jaymospowers.web_symbiote.say.white.lash.2": "A warning, with all our arms.",
	"message.jaymospowers.web_symbiote.say.white.lash.3": "Stay off us.",
	"message.jaymospowers.web_symbiote.say.red.lash.1": "Whip! Whip! WHIP!",
	"message.jaymospowers.web_symbiote.say.red.lash.2": "Everyone gets a taste.",
	"message.jaymospowers.web_symbiote.say.red.lash.3": "Strip them, every one.",
	"message.jaymospowers.web_symbiote.say.red.rupture.1": "Pounce. Pin. Open.",
	"message.jaymospowers.web_symbiote.say.red.rupture.2": "Hold still. HOLD STILL.",
	"message.jaymospowers.web_symbiote.say.red.rupture.3": "Teeth. Then more teeth.",
	"message.jaymospowers.web_symbiote.say.red.execute_rupture.1": "Again! Again! Again!",
	"message.jaymospowers.web_symbiote.say.red.execute_rupture.2": "Stab, stab, stab.",
	"message.jaymospowers.web_symbiote.say.red.execute_rupture.3": "Make it burst.",
	"message.jaymospowers.web_symbiote.say.nightstep.1": "Through the dark. We are the dark.",
	"message.jaymospowers.web_symbiote.say.nightstep.2": "Step. Step. Gone.",
	"message.jaymospowers.web_symbiote.say.nightstep.3": "They never see where we land.",
	"message.jaymospowers.web_symbiote.say.onslaught.1": "Rise. All of us. Rise.",
	"message.jaymospowers.web_symbiote.say.onslaught.2": "A crown of us. Kneel.",
	"message.jaymospowers.web_symbiote.say.onslaught.3": "Everything within reach. Everything.",
	"message.jaymospowers.web_symbiote.say.white.onslaught.1": "We did not want this. They made us.",
	"message.jaymospowers.web_symbiote.say.white.onslaught.2": "Gently. And then not at all.",
	"message.jaymospowers.web_symbiote.say.white.onslaught.3": "All our arms. Forgive us.",
	"message.jaymospowers.web_symbiote.say.red.onslaught.1": "CROWN! CROWN! KILL!",
	"message.jaymospowers.web_symbiote.say.red.onslaught.2": "More arms. MORE.",
	"message.jaymospowers.web_symbiote.say.red.onslaught.3": "Everything dies in the circle.",
	"message.jaymospowers.web_symbiote.say.slam.1": "Two of them. Close them like a hand.",
	"message.jaymospowers.web_symbiote.say.slam.2": "Together, then. Slam them together.",
	"message.jaymospowers.web_symbiote.say.slam.3": "Both. Now.",
	"message.jaymospowers.web_symbiote.say.white.slam.1": "Two. Too close. Clap them away.",
	"message.jaymospowers.web_symbiote.say.white.slam.2": "We'll be quick. Both of you.",
	"message.jaymospowers.web_symbiote.say.white.slam.3": "Please. Stop.",
	"message.jaymospowers.web_symbiote.say.red.slam.1": "Two! SLAM THEM!",
	"message.jaymospowers.web_symbiote.say.red.slam.2": "Crack them together!",
	"message.jaymospowers.web_symbiote.say.red.slam.3": "Bring them in. Bring them HARD."
