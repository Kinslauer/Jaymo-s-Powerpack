{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "feather",
        "model": {
          "type": "minecraft:model",
          "model": "jaymospowers:item/tinkering/part/fletching_feather"
        }
      },
      {
        "when": "leaves",
        "model": {
          "type": "minecraft:model",
          "model": "jaymospowers:item/tinkering/part/fletching_leaves"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "jaymospowers:item/tinkering/part/fletching_feather"
    }
  }
}
