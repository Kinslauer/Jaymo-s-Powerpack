{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "gold",
        "model": {
          "type": "minecraft:model",
          "model": "jaymospowers:item/jewellery/circlet_frame_gold"
        }
      },
      {
        "when": "silver",
        "model": {
          "type": "minecraft:model",
          "model": "jaymospowers:item/jewellery/circlet_frame_silver"
        }
      },
      {
        "when": "copper",
        "model": {
          "type": "minecraft:model",
          "model": "jaymospowers:item/jewellery/circlet_frame_copper"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "jaymospowers:item/jewellery/circlet_frame_silver"
    }
  }
}
