{
	"schemaVersion": 1,
	"id": "jaymospowers",
	"version": "${version}",
	"name": "Jaymo's Powers",
	"description": "Every player awakens a superpower at some point in survival (or picks one in creative): Wind Control, Pocket Arsenal, Web Slinging, Chronokinesis and Gravity. Made to be played alongside Jaymo's Kitchen.",
	"authors": [],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.jaymospowers.JaymosPowers"],
		"client": ["com.jaymospowers.client.JaymosPowersClient"],
		"server": ["com.jaymospowers.JaymosPowersServer"],
		"preLaunch": ["com.jaymospowers.client.CameraPreset", "com.jaymospowers.core.PickupPreset", "com.jaymospowers.client.ShaderPreset"],
		"jei_mod_plugin": ["com.jaymospowers.client.jei.TinkeringJei", "com.jaymospowers.client.jei.MedicineJei"],
		"jade": ["com.jaymospowers.client.compat.JadeEntitiesOnly"]
	},
	"mixins": [
		"jaymospowers.mixins.json",
		{ "config": "jaymospowers.client.mixins.json", "environment": "client" },
		"jaymospowers.bettercombat.mixins.json",
		{ "config": "jaymospowers.bettercombat.client.mixins.json", "environment": "client" },
		"jaymospowers.wind.mixins.json",
		{ "config": "jaymospowers.wind.client.mixins.json", "environment": "client" },
		"jaymospowers.arsenal.mixins.json",
		{ "config": "jaymospowers.arsenal.client.mixins.json", "environment": "client" },
		"jaymospowers.web.mixins.json",
		{ "config": "jaymospowers.web.client.mixins.json", "environment": "client" },
		"jaymospowers.chrono.mixins.json",
		{ "config": "jaymospowers.chrono.client.mixins.json", "environment": "client" },
		"jaymospowers.gravity.mixins.json",
		{ "config": "jaymospowers.gravity.client.mixins.json", "environment": "client" },
		"jaymospowers.resonance.mixins.json",
		{ "config": "jaymospowers.resonance.client.mixins.json", "environment": "client" },
		"jaymospowers.darktide.mixins.json",
		{ "config": "jaymospowers.darktide.client.mixins.json", "environment": "client" },
		"jaymospowers.tinkering.mixins.json",
		"jaymospowers.enchanting.mixins.json",
		"jaymospowers.xenoform.mixins.json",
		{ "config": "jaymospowers.xenoform.client.mixins.json", "environment": "client" },
		"jaymospowers.zfighter.mixins.json",
		{ "config": "jaymospowers.zfighter.client.mixins.json", "environment": "client" },
		{ "config": "jaymospowers.nea.client.mixins.json", "environment": "client" },
		{ "config": "jaymospowers.tnm.client.mixins.json", "environment": "client" },
		{ "config": "jaymospowers.shouldersurfing.client.mixins.json", "environment": "client" },
		"jaymospowers.smoke.mixins.json",
		{ "config": "jaymospowers.smoke.client.mixins.json", "environment": "client" },
		{ "config": "jaymospowers.rig.client.mixins.json", "environment": "client" },
		{ "config": "jaymospowers.cryo.client.mixins.json", "environment": "client" },
		"jaymospowers.ember.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"jaymoskitchen": "*"
	},
	"suggests": {
		"weaponmod": "*"
	}
}
