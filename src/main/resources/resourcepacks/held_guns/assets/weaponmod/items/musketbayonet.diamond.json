{
  "model": {
    "type": "minecraft:condition",
    "property": "weaponmod:reload",
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "weaponmod:item/musketbayonet.diamond"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "jaymospowers:item/gun/musketbayonet_diamond"
      }
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "weaponmod:item/musketbayonet.diamond_reload"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "jaymospowers:item/gun/musketbayonet_diamond_reload"
      }
    }
  }
}