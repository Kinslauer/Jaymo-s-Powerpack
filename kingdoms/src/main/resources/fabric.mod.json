{
	"schemaVersion": 1,
	"id": "jaymoskingdoms",
	"version": "${version}",
	"name": "Jaymo's Kingdoms",
	"description": "Kingdoms rise at the villages of the world, each under a king who is a boss to be reckoned with. Pledge yourself to one, climb its ranks, fill its treasury, and mind your reputation: every kingdom remembers what you've done.",
	"authors": [],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.jaymoskingdoms.JaymosKingdoms"],
		"client": ["com.jaymoskingdoms.client.JaymosKingdomsClient"]
	},
	"mixins": [
		"jaymoskingdoms.combat.mixins.json",
		"jaymoskingdoms.worldgen.mixins.json",
		"jaymoskingdoms.mca.mixins.json",
		"jaymoskingdoms.trees.mixins.json",
		"jaymoskingdoms.villagers.mixins.json",
		"jaymoskingdoms.lootgoblins.mixins.json",
		"jaymoskingdoms.equestrian.mixins.json",
		"jaymoskingdoms.pathing.mixins.json",
		"jaymoskingdoms.weaponmod.mixins.json",
		"jaymoskingdoms.bettercombat.mixins.json",
		"jaymoskingdoms.moons.mixins.json",
		"jaymoskingdoms.disasters.mixins.json",
		"jaymoskingdoms.sleep.mixins.json",
		"jaymoskingdoms.sailing.mixins.json",
		{ "config": "jaymoskingdoms.combat.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.mca.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.equestrian.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.moons.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.sleep.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.sailing.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.vampires.client.mixins.json", "environment": "client" },
		{ "config": "jaymoskingdoms.disasters.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"bettercombat": "*",
		"magistuarmory": "*",
		"mr_ati_structuresvanillaedition": "*",
		"mca": "*"
	}
