{
  "dialogue.chat.jaymoskingdoms.question.wordless": "They babble at you in a tongue you don't know, eyes on your weapon.",
  "dialogue.chat.jaymoskingdoms.question.opening.afraid.0": "Please, %1$s! Don't! I'll tell you anything!",
  "dialogue.chat.jaymoskingdoms.question.opening.afraid.1": "Wait, wait! What do you want to know?",
  "dialogue.chat.jaymoskingdoms.question.opening.afraid.2": "Mercy, %1$s! Ask, and I'll answer!",
  "dialogue.chat.jaymoskingdoms.question.opening.defiant.0": "Do it then, %1$s. You'll get nothing from me.",
  "dialogue.chat.jaymoskingdoms.question.opening.defiant.1": "*spits* Go on. Ask your questions.",
  "dialogue.chat.jaymoskingdoms.question.opening.defiant.2": "I've nothing to say to you.",
  "dialogue.chat.jaymoskingdoms.question.refuse.0": "I said nothing, and I'll say nothing.",
  "dialogue.chat.jaymoskingdoms.question.refuse.1": "Ask all you like, %1$s.",
  "dialogue.chat.jaymoskingdoms.question.refuse.2": "*they glare at you and say nothing*",
  "dialogue.chat.jaymoskingdoms.question.threat.broken.0": "All right! All right! Just stop!",
  "dialogue.chat.jaymoskingdoms.question.threat.broken.1": "No more, %1$s, please. I'll talk.",
  "dialogue.chat.jaymoskingdoms.question.threat.broken.2": "*they flinch from the edge* Fine! Ask!",
  "dialogue.chat.jaymoskingdoms.question.threat.held.0": "Is that all you've got?",
  "dialogue.chat.jaymoskingdoms.question.threat.held.1": "*they grit their teeth and hold your stare*",
  "dialogue.chat.jaymoskingdoms.question.threat.held.2": "You don't scare me, %1$s.",
  "dialogue.chat.jaymoskingdoms.question.threat.never.0": "Kill me or let me go. I'm done talking.",
  "dialogue.chat.jaymoskingdoms.question.threat.never.1": "*they shut their eyes and wait for the blow*",
  "dialogue.chat.jaymoskingdoms.question.threat.never.2": "Nothing you do will make me speak.",
  "dialogue.chat.jaymoskingdoms.question.leader.none.0": "No one! I answer to no one!",
  "dialogue.chat.jaymoskingdoms.question.leader.none.1": "I've no lord, %1$s. I'm nobody's.",
  "dialogue.chat.jaymoskingdoms.question.leader.none.2": "There's no one. I swear it.",
  "dialogue.chat.jaymoskingdoms.question.leader.realm.0": "%2$s. %2$s rules %3$s.",
  "dialogue.chat.jaymoskingdoms.question.leader.realm.1": "I serve %3$s. %2$s sits the throne.",
  "dialogue.chat.jaymoskingdoms.question.leader.realm.2": "%2$s! It's %2$s of %3$s you want, not me!",
  "dialogue.chat.jaymoskingdoms.question.leader.empty.0": "%2$s has no ruler now. No one's taken the seat.",
  "dialogue.chat.jaymoskingdoms.question.leader.empty.1": "No one rules %2$s just now. That's the truth.",
  "dialogue.chat.jaymoskingdoms.question.leader.empty.2": "The seat of %2$s is empty, %1$s.",
  "dialogue.chat.jaymoskingdoms.question.leader.camp.0": "%2$s leads us, the whole of %3$s.",
  "dialogue.chat.jaymoskingdoms.question.leader.camp.1": "We run with %2$s. Everyone in %3$s does.",
  "dialogue.chat.jaymoskingdoms.question.leader.camp.2": "It's %2$s's word we live by. %3$s.",
  "dialogue.chat.jaymoskingdoms.question.home.none.0": "I've no home. I sleep where I fall.",
  "dialogue.chat.jaymoskingdoms.question.home.none.1": "Nowhere, %1$s. There's nowhere.",
  "dialogue.chat.jaymoskingdoms.question.home.none.2": "Home? I don't have one.",
  "dialogue.chat.jaymoskingdoms.question.home.realm.0": "The seat of %4$s is about %2$s blocks %3$s of here.",
  "dialogue.chat.jaymoskingdoms.question.home.realm.1": "%4$s. Go %3$s, %2$s blocks or so.",
  "dialogue.chat.jaymoskingdoms.question.home.realm.2": "%3$s! Some %2$s blocks %3$s, that's where %4$s's seat is!",
  "dialogue.chat.jaymoskingdoms.question.home.camp.0": "The camp's %3$s of here. %2$s blocks, maybe.",
  "dialogue.chat.jaymoskingdoms.question.home.camp.1": "Go %3$s, about %2$s blocks. You'll smell the fires.",
  "dialogue.chat.jaymoskingdoms.question.home.camp.2": "%4$s lies %3$s, some %2$s blocks off.",
  "dialogue.chat.jaymoskingdoms.question.way.0": "east",
  "dialogue.chat.jaymoskingdoms.question.way.1": "south-east",
  "dialogue.chat.jaymoskingdoms.question.way.2": "south",
  "dialogue.chat.jaymoskingdoms.question.way.3": "south-west",
  "dialogue.chat.jaymoskingdoms.question.way.4": "west",
  "dialogue.chat.jaymoskingdoms.question.way.5": "north-west",
  "dialogue.chat.jaymoskingdoms.question.way.6": "north",
  "dialogue.chat.jaymoskingdoms.question.way.7": "north-east",
  "dialogue.chat.jaymoskingdoms.question.threat.rough_broken.0": "Agh! Stop! I'll talk, I'll talk!",
  "dialogue.chat.jaymoskingdoms.question.threat.rough_broken.1": "*they cry out* Enough, %1$s! Ask!",
  "dialogue.chat.jaymoskingdoms.question.threat.rough_broken.2": "No more! Please! What do you want?",
  "dialogue.chat.jaymoskingdoms.question.stare.broken.0": "*they look away first* ...Fine. Ask.",
  "dialogue.chat.jaymoskingdoms.question.stare.broken.1": "Stop looking at me like that. I'll tell you.",
  "dialogue.chat.jaymoskingdoms.question.stare.broken.2": "*their jaw trembles* What do you want to know, %1$s?",
  "dialogue.chat.jaymoskingdoms.question.stare.held.0": "*they stare right back*",
  "dialogue.chat.jaymoskingdoms.question.stare.held.1": "You can look all you like.",
  "dialogue.chat.jaymoskingdoms.question.stare.held.2": "Your eyes don't frighten me, %1$s.",
  "dialogue.chat.jaymoskingdoms.question.swear.0": "I swear it. I'll never raise a hand to you, %1$s.",
  "dialogue.chat.jaymoskingdoms.question.swear.1": "On my life, I'll never lift a hand against you.",
  "dialogue.chat.jaymoskingdoms.question.swear.2": "I swear! Never again, %1$s. Never.",
  "dialogue.chat.jaymoskingdoms.question.nearby.none.0": "No one. I'm alone out here.",
  "dialogue.chat.jaymoskingdoms.question.nearby.none.1": "There's nobody, %1$s. Just me.",
  "dialogue.chat.jaymoskingdoms.question.nearby.none.2": "None of mine are near, I swear it.",
  "dialogue.chat.jaymoskingdoms.question.nearby.some.0": "There's %2$s of us about. %3$s of them carry arms.",
  "dialogue.chat.jaymoskingdoms.question.nearby.some.1": "%2$s within shouting distance, %1$s. %3$s are guards.",
  "dialogue.chat.jaymoskingdoms.question.nearby.some.2": "Maybe %2$s nearby... %3$s with weapons.",
  "dialogue.chat.jaymoskingdoms.question.player.leader.none": "I'm sworn to no realm.",
  "dialogue.chat.jaymoskingdoms.question.player.leader.empty": "I belong to %s, but nobody sits the seat.",
  "dialogue.chat.jaymoskingdoms.question.player.leader.realm": "%s rules us, in %s.",
  "dialogue.chat.jaymoskingdoms.question.player.home.none": "I've no home to speak of.",
  "dialogue.chat.jaymoskingdoms.question.player.home.realm": "The seat is about %s blocks %s of here. %s."
}
