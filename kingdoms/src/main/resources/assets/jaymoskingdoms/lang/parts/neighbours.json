  "neighbours.jaymoskingdoms.mercy.4": "Ow! Leave me be!",
  "neighbours.jaymoskingdoms.mercy.5": "I'll tell the guards!",
  "neighbours.jaymoskingdoms.mercy.6": "What did I ever do to you?",
  "neighbours.jaymoskingdoms.mercy.7": "Help! Someone help!",
