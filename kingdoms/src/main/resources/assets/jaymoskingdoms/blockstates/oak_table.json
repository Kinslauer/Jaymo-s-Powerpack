{
  "multipart": [
    {
      "apply": {
        "model": "jaymoskingdoms:block/oak_table_top"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/oak_table_leg"
      },
      "when": {
        "north": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/oak_table_leg",
        "y": 90,
        "uvlock": true
      },
      "when": {
        "north": "false",
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/oak_table_leg",
        "y": 180,
        "uvlock": true
      },
      "when": {
        "south": "false",
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/oak_table_leg",
        "y": 270,
        "uvlock": true
      },
      "when": {
        "south": "false",
        "west": "false"
      }
    }
  ]
}
