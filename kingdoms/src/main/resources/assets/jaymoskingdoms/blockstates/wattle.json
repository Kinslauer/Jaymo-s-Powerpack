{
  "multipart": [
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_post_ends"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_post"
      },
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_cap"
      },
      "when": {
        "north": "true",
        "east": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_cap",
        "y": 90
      },
      "when": {
        "north": "false",
        "east": "true",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_cap_alt"
      },
      "when": {
        "north": "false",
        "east": "false",
        "south": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_cap_alt",
        "y": 90
      },
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "jaymoskingdoms:block/wattle_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    }
  ]
